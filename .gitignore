# --- Embeddings / vector index (regenerable, often large/binary) ---
domain/retrieval/index/
*.faiss
*.index
embeddings_cache/

# --- Golden set: KEEP tracked (small, hand-labeled, source of truth) ---
!evaluation/golden_set.jsonl

# --- Logs ---
*.log
logs/

